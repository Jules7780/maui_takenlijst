<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TakenlijstApp.PersonenLijstPagina"
             Title="Personen">
    <VerticalStackLayout>
        <CollectionView ItemsSource="{Binding Personen}"
                        SelectedItem="{Binding GeselecteerdePersoon}"
                        SelectionMode="Single">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <HorizontalStackLayout Padding="16,8,16,8">
                        <VerticalStackLayout>
                            <Label Text="{Binding Voornaam}"/>
                            <Label Text="{Binding Achternaam}"/>
                        </VerticalStackLayout>
                        <Label Text="{Binding Leeftijd}" />
                    </HorizontalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        <Button
                Text="Nieuw persoon"
                Command="{Binding NieuwPersoonCommand}"/>
    </VerticalStackLayout>
</ContentPage>