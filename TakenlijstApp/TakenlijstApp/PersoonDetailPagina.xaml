<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TakenlijstApp.PersoonDetailPagina"
             Title="{Binding Voornaam}">
    <VerticalStackLayout>
        <Image Source="{Binding Url}" HeightRequest="100"/>

        <Label Text="FOTO (URL)"/>
        <Entry Text="{Binding Url}" />
        
        <Label Text="VOORNAAM"/>
        <Entry Text="{Binding Voornaam}" />


        <Label Text="FAMILIENAAM"/>
        <Entry Text="{Binding Achternaam}" />

        <Label Text="GEBOORTEDATUM"/>
        <DatePicker Date="{Binding Geboortedatum}"/>

        <HorizontalStackLayout>
            <Button Text="Annuleren" Command="{Binding AnnulerenCommand}"/>
            <Button Text="Bewaren" Command="{Binding BewarenCommand}"/>
            <Button Text="Verwijder" Command="{Binding VerwijderCommand}"/>
        </HorizontalStackLayout>

    </VerticalStackLayout>
</ContentPage>